{
  "name": "@konitif/scene",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Headless scene environment, day-cycle curves and articulated model descriptions, independent of surfaces and renderers.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@konitif/core": "0.284.2"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeMouf/konitif-scene.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
